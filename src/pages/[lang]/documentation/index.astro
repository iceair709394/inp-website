---
/**
 * Documentation—— 文档导航页。
 * 导航由 data 里的 groups 驱动，页面不手写条目列表。
 * 当前 groups 为空：文档条目尚未提供，显示空状态。
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import { requireLocale, localeStaticPaths } from '@/i18n/routing';
import { t } from '@/i18n/ui';
import { getDocumentation } from '@/data/documentation';
import { getBrand } from '@/data/brand';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = requireLocale(Astro.params.lang);
const documentation = getDocumentation(locale);
const brand = getBrand(locale);

const title = `${documentation.heading} — ${brand.name}`;
const description = documentation.subheading;
---

<PageLayout locale={locale} path="/documentation" title={title} description={description}>
  <Section heading={documentation.heading} level="h1">
    <p class="max-w-3xl text-base">{documentation.subheading}</p>
    {documentation.intro && (
      <p class="mt-3 max-w-3xl text-sm opacity-90">{documentation.intro}</p>
    )}

    {documentation.groups.length === 0 ? (
      <p class="mt-6 text-sm opacity-80">{t(locale, 'notice.docsEmpty')}</p>
    ) : (
      <div class="mt-6 space-y-8">
        {documentation.groups.map((group) => (
          <section id={group.id}>
            <h3 class="text-base font-semibold">{group.title}</h3>
            <ul class="mt-3 space-y-2 text-sm">
              {group.entries.map((entry) => (
                <li>
                  <a
                    href={`/${locale}/documentation/${entry.slug}/`}
                    class="underline underline-offset-2"
                  >
                    {entry.title}
                  </a>
                  {entry.summary && <p class="mt-1 opacity-80">{entry.summary}</p>}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )}
  </Section>
</PageLayout>
