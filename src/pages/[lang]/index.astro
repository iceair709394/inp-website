---
/**
 * Home：当前只有一屏 Hero（是什么 / 有什么 / 为什么值得看）。
 * Introduction 与 Philosophy 的文案仍保留在 src/data/home，等首页第二屏做出来再接。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { requireLocale, localeStaticPaths } from '@/i18n/routing';
import { getBrand } from '@/data/brand';
import { getHero } from '@/data/hero';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = requireLocale(Astro.params.lang);
const brand = getBrand(locale);
const hero = getHero(locale);

const title = `${brand.name} — ${brand.positioning}`;
const description = `${hero.titlePre} ${hero.titleEm} ${hero.descLines.join(' ')}`.replace(/\s+/g, ' ').trim();
---

<BaseLayout locale={locale} path="/" {title} {description}>
  <Hero {locale} />
</BaseLayout>
