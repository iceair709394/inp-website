---
/**
 * Download。
 * 没有真实版本：Download 按钮为禁用态，releases 为空时显示空状态，不生成任何下载地址。
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import CtaLinks from '@/components/CtaLinks.astro';
import { requireLocale, localeStaticPaths } from '@/i18n/routing';
import { t } from '@/i18n/ui';
import { getDownload } from '@/data/download';
import { getBrand } from '@/data/brand';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = requireLocale(Astro.params.lang);
const download = getDownload(locale);
const brand = getBrand(locale);

const title = `${download.heading} — ${brand.name}`;
const description = download.subheading;
---

<PageLayout locale={locale} path="/download" title={title} description={description}>
  <Section heading={download.heading} level="h1">
    <p class="max-w-3xl text-base">{download.subheading}</p>

    {download.note && <p class="mt-3 max-w-3xl text-sm opacity-90">{download.note}</p>}

    <CtaLinks ctas={download.ctas} locale={locale} />

    {download.releases.length === 0 ? (
      <p class="mt-6 text-sm opacity-80">{t(locale, 'notice.downloadEmpty')}</p>
    ) : (
      <ul class="mt-6 divide-y">
        {download.releases.map((release) => (
          <li class="py-4">
            <p class="text-sm font-semibold">{release.version}</p>
            <p class="text-xs opacity-70">{release.date}</p>
            <ul class="mt-2 list-disc ps-5 text-sm">
              {release.notes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    )}
  </Section>
</PageLayout>
