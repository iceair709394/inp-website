---
/**
 * 404 页（静态输出下由宿主决定何时返回本页）。
 * 不输出 canonical，不索引。
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/Section.astro';
import { DEFAULT_LOCALE } from '@/i18n/locales';
import { localePath } from '@/i18n/utils';
import { t } from '@/i18n/ui';

const locale = DEFAULT_LOCALE;
const title = t(locale, 'notice.notFoundTitle');
---

<PageLayout
  locale={locale}
  path="/"
  title={title}
  description={t(locale, 'notice.notFoundBody')}
  noIndex
  withCanonical={false}
>
  <Section>
    <h1 class="text-2xl font-semibold sm:text-3xl">{title}</h1>
    <p class="mt-3 text-sm opacity-80">{t(locale, 'notice.notFoundBody')}</p>
    <p class="mt-6">
      <a href={localePath(locale, '/')} class="text-sm underline underline-offset-2">
        {t(locale, 'action.backToHome')}
      </a>
    </p>
  </Section>
</PageLayout>
