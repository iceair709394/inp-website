---
/**
 * 政策/下载页的通用渲染：标题 + 定位说明 + 更新日期 + 若干章节。
 * 章节只有两种内容：段落与并列条目，够用即可，不做富文本。
 */
import Container from './Container.astro';
import type { LegalDoc } from '@/data/types';

interface Props {
  doc: LegalDoc;
  /** 顶部提示条（下载页用来标“未签名 / 预览版”） */
  notice?: string;
}

const { doc, notice } = Astro.props;
---

<article class="py-10 sm:py-14">
  <Container>
    <h1 class="text-2xl font-semibold sm:text-3xl">{doc.heading}</h1>
    <p class="mt-3 max-w-3xl text-base opacity-90">{doc.lead}</p>
    <p class="mt-2 text-xs opacity-70">{doc.updated}</p>

    {notice && <p class="mt-6 max-w-3xl rounded border px-4 py-3 text-sm">{notice}</p>}

    <div class="mt-10 space-y-8">
      {doc.sections.map((section) => (
        <section>
          <h2 class="text-lg font-semibold sm:text-xl">{section.heading}</h2>
          {section.paragraphs && (
            <div class="mt-2 max-w-3xl space-y-3 text-sm">
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          )}
          {section.bullets && (
            <ul class="mt-3 max-w-3xl list-disc space-y-2 pl-5 text-sm">
              {section.bullets.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </div>

    {doc.footerNote && <p class="mt-10 max-w-3xl text-xs opacity-70">{doc.footerNote}</p>}
  </Container>
</article>
