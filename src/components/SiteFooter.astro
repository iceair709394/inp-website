---
/**
 * 全站页脚：品牌三行 + 页脚导航 + 社交（当前为空）+ 版权。
 * 品牌文案取文案原文；社交区块在未配置账号时不渲染，不生成死链。
 */
import Container from './Container.astro';
import { FOOTER_NAV, LEGAL_NAV } from '@/config/navigation';
import { activeSocialLinks } from '@/config/social';
import { getBrand } from '@/data/brand';
import { t } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const brand = getBrand(locale);
const socials = activeSocialLinks();
const currentPath = Astro.url.pathname;
---

<footer class="mt-10 border-t">
  <Container>
    <div class="flex flex-col gap-6 py-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="space-y-1 text-sm">
        <p class="font-semibold">{brand.footerBrandLine}</p>
        <p class="opacity-80">{brand.positioning}</p>
        <p class="opacity-80">{brand.slogan}</p>
      </div>

      <nav class="text-sm" aria-label="Footer navigation">
        <ul class="flex flex-wrap gap-x-4 gap-y-2">
          {FOOTER_NAV.map((item) => {
            const href = localePath(locale, item.path);
            const isActive = currentPath === href || currentPath === href.replace(/\/$/, '');
            return (
              <li>
                <a
                  href={href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={['underline-offset-2 hover:underline', isActive ? 'font-semibold' : 'opacity-80']}
                >
                  {t(locale, item.labelKey)}
                </a>
              </li>
            );
          })}
        </ul>

        {socials.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
            {socials.map((item) => (
              <li>
                <a href={item.href ?? '#'} rel="noopener noreferrer" target="_blank" class="underline-offset-2 hover:underline">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        )}

        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-xs">
          {LEGAL_NAV.map((item) => (
            <li>
              <a href={localePath(locale, item.path)} class="opacity-70 underline-offset-2 hover:underline">
                {t(locale, item.labelKey)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <p class="border-t py-4 text-xs opacity-70">{brand.copyright}</p>
  </Container>
</footer>
