---
/**
 * 首页主视觉（一屏）：四角色轮播 + 台词气泡 + 五张功能卡。
 * 视觉与交互来自 inp-hero-v2（Claude 第二版），文案全部取自 src/data/hero。
 * 图片为 public/hero 下的 webp。
 */
import LocaleSwitcher from './LocaleSwitcher.astro';
import { FOOTER_NAV, PRIMARY_NAV } from '@/config/navigation';
import { getBrand } from '@/data/brand';
import { getHero } from '@/data/hero';
import { getHome } from '@/data/home';
import { t } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const hero = getHero(locale);
const brand = getBrand(locale);
const home = getHome(locale);
const currentPath = Astro.url.pathname;

/** 默认主角：INP */
const defaultKey = 'inp';

---

<header class="site-header">
  <a class="brand" href={localePath(locale, '/')} aria-label="INP home">
    <span class="brand__text">
      <span class="brand__name">{brand.name}</span>
      <span class="brand__tag">{brand.positioning}</span>
    </span>
  </a>

  <nav class="nav" id="site-nav" aria-label="Main">
    <ul class="nav__list">
      {PRIMARY_NAV.map((item) => {
        const href = localePath(locale, item.path);
        const isActive = currentPath === href || currentPath === href.replace(/\/$/, '');
        return (
          <li>
            <a href={href} aria-current={isActive ? 'page' : undefined} class="nav__link">
              {t(locale, item.labelKey)}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="header__actions">
    <div class="lang">
      <LocaleSwitcher {locale} path={currentPath} />
    </div>
    <a class="btn btn--primary btn--sm btn--header" href="#story">{t(locale, 'action.getStarted')}</a>
    <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</header>

<main id="top">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="hero__inner">
      <div class="hero__copy">
        <p class="wordmark" aria-hidden="true">
          <img class="wordmark__logo" src="/hero/logo.webp" width="900" height="372" alt="" decoding="async">
        </p>
        <h1 class="hero__title" id="hero-title">{hero.titlePre} <em>{hero.titleEm}</em></h1>
        <p class="hero__subtitle">{hero.subtitle}</p>
        <div class="hero__rule" aria-hidden="true"></div>
        <p class="hero__desc">
          {hero.descLines.map((line) => <span>{line}</span>)}
        </p>
        <div class="hero__cta">
          {hero.ctas.map((cta, index) =>
            cta.disabled ? (
              <div class="hero__download">
                <span class="btn btn--ghost btn--disabled" aria-disabled="true">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.6 10.4 4.5v7H3zM11.4 4.35 21 3.2v8.3h-9.6zM3 12.5h7.4v7L3 18.4zM11.4 12.5H21V20.8l-9.6-1.25z"/></svg>
                  {t(locale, cta.labelKey)}
                </span>
                <p class="hero__coming-soon">{hero.comingSoon}</p>
              </div>
            ) : (
              <a class="btn btn--primary" href={cta.path}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M10 8.5v7l5.5-3.5z" fill="currentColor"/></svg>
                {t(locale, cta.labelKey)}
              </a>
            )
          )}
        </div>
      </div>
    </div>

    <div class="stage" id="stage" role="group" aria-label="INP Avatars">
      <img class="avatar avatar--deeyo" data-avatar="deeyo" data-slot="3" src="/hero/avatar_01_deeyo.webp" width="787" height="1400" alt="Deeyo — silver-haired Avatar with a cyan halo" loading="eager" decoding="async">
      <img class="avatar avatar--yomiku" data-avatar="yomiku" data-slot="1" src="/hero/avatar_03_yomiku.webp" width="787" height="1400" alt="Yomiku — white-haired cat-ear Avatar in pink and white" loading="eager" decoding="async">
      <img class="avatar avatar--laysa" data-avatar="laysa" data-slot="2" src="/hero/avatar_04_laysa.webp" width="787" height="1400" alt="Laysa — light-furred Avatar with pilot goggles" loading="eager" decoding="async">
      <img class="avatar avatar--inp" data-avatar="inp" data-slot="0" src="/hero/avatar_02_inp.webp" width="787" height="1400" alt="INP — purple-haired Avatar in street style" loading="eager" decoding="async">

      <div class="bubble bubble--pop" id="bubble" aria-hidden="true">
        <span class="bubble__name" id="bubble-name">INP</span>
        <p class="bubble__text" id="bubble-text"></p>
      </div>
      <p class="sr-only" id="avatar-live" aria-live="polite"></p>

      <button class="stage__arrow stage__arrow--next" id="avatar-next" type="button" aria-label="Next avatar">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

  </section>

  <section class="story" id="story" aria-label="About INP">
    <div class="story__block">
      <h2>{home.introduction.heading}</h2>
      {home.introduction.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="story__block">
      <h2>{home.philosophy.heading}</h2>
      {home.philosophy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__line">{brand.footerBrandLine}</p>
      <p>{brand.positioning}</p>
      <p>{brand.slogan}</p>
    </div>

    <nav class="site-footer__navwrap" aria-label="Footer navigation">
      <ul class="site-footer__nav">
        {FOOTER_NAV.map((item) => {
          const href = localePath(locale, item.path);
          const isActive = currentPath === href || currentPath === href.replace(/\/$/, '');
          return (
            <li>
              <a href={href} aria-current={isActive ? 'page' : undefined}>
                {t(locale, item.labelKey)}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>

  <p class="site-footer__copy">{brand.copyright}</p>
</footer>

<script>
  const btn = document.getElementById('menu-toggle');
  const nav = document.getElementById('site-nav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('nav--open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) {
        nav.classList.remove('nav--open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

<script define:vars={{ avatars: hero.avatars, defaultKey }}>
  (function () {
    var list = avatars;
    var stage = document.getElementById('stage');
    var bubble = document.getElementById('bubble');
    var nameEl = document.getElementById('bubble-name');
    var textEl = document.getElementById('bubble-text');
    var live = document.getElementById('avatar-live');
    var next = document.getElementById('avatar-next');
    if (!stage || !bubble || !nameEl || !textEl || !next) return;

    var imgs = {};
    list.forEach(function (a) {
      var el = stage.querySelector('[data-avatar="' + a.key + '"]');
      if (el) imgs[a.key] = el;
    });

    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var cur = 0;
    for (var i = 0; i < list.length; i++) {
      if (list[i].key === defaultKey) { cur = i; break; }
    }
    var timer = null;

    function say(a) {
      if (timer) { clearInterval(timer); timer = null; }
      nameEl.textContent = a.name;
      live.textContent = a.name + ': ' + a.line;
      bubble.classList.remove('bubble--pop');
      void bubble.offsetWidth;
      bubble.classList.add('bubble--pop');
      if (reduce) {
        textEl.textContent = a.line;
        bubble.classList.remove('bubble--typing');
        return;
      }
      textEl.textContent = '';
      bubble.classList.add('bubble--typing');
      var i = 0;
      timer = setInterval(function () {
        i++;
        textEl.textContent = a.line.slice(0, i);
        if (i >= a.line.length) {
          clearInterval(timer);
          timer = null;
          bubble.classList.remove('bubble--typing');
        }
      }, 24);
    }

    function render(speak) {
      var n = list.length;
      list.forEach(function (a, idx) {
        if (imgs[a.key]) imgs[a.key].setAttribute('data-slot', String((idx - cur + n) % n));
      });
      if (speak) say(list[cur]);
    }

    function go(step) {
      cur = (cur + step + list.length) % list.length;
      render(true);
    }

    next.addEventListener('click', function () { go(1); });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') go(1);
    });

    var sx = null, sy = null;
    document.addEventListener('touchstart', function (e) {
      var r = stage.getBoundingClientRect(), tp = e.touches[0];
      var inside = tp.clientX >= r.left && tp.clientX <= r.right && tp.clientY >= r.top && tp.clientY <= r.bottom;
      sx = inside ? tp.clientX : null;
      sy = tp.clientY;
    }, { passive: true });
    document.addEventListener('touchend', function (e) {
      if (sx === null) return;
      var tp = e.changedTouches[0], dx = tp.clientX - sx, dy = tp.clientY - sy;
      sx = null;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5 && dx < 0) go(1);
    }, { passive: true });

    render(false);
    say(list[cur]);
  })();
</script>

<style is:global>
  :root {
    --bg-0: #0B0714;
    --bg-1: #120A22;
    --purple: #8B5CF6;
    --purple-2: #A855F7;
    --purple-glow: #C084FC;
    --cyan: #22D3EE;
    --text: #E8E3F5;
    --text-dim: #A99FC4;
    --glass: rgba(255, 255, 255, 0.06);
    --glass-fallback: rgba(30, 18, 52, 0.88);
    --glass-line: rgba(255, 255, 255, 0.12);
    --radius: 16px;
    --nav-h: 68px;
    --font: "Inter", "PingFang SC", "微软雅黑", -apple-system, "Segoe UI", sans-serif;
  }

  html { background: var(--bg-0); scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg-0);
    color: var(--text);
    font-family: var(--font);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; cursor: pointer; }
  :focus-visible { outline: 2px solid var(--purple-glow); outline-offset: 3px; border-radius: 8px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>

<style>
  .site-header {
    position: absolute; top: 0; left: 0; right: 0; z-index: 20;
    height: var(--nav-h);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 clamp(20px, 4vw, 56px);
    background: linear-gradient(180deg, rgba(11, 7, 20, .75), rgba(11, 7, 20, 0));
  }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand__text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand__name { font-weight: 700; font-size: 16px; }
  .brand__tag { font-size: 12px; color: var(--text-dim); }

  .nav__list { display: flex; gap: clamp(20px, 3vw, 44px); list-style: none; margin: 0; padding: 0; }
  .nav__link { position: relative; padding: 8px 0; font-size: 15px; color: var(--text); opacity: .82; transition: opacity .2s; }
  .nav__link:hover { opacity: 1; }
  .nav__link[aria-current="page"] { opacity: 1; font-weight: 600; }
  .nav__link[aria-current="page"]::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
    background: var(--purple-glow); border-radius: 2px;
  }

  .header__actions { display: flex; align-items: center; gap: 18px; }
  .lang { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 48px; padding: 0 28px;
    border-radius: 999px; border: 1px solid transparent;
    font-size: 16px; font-weight: 600; white-space: nowrap;
    transition: transform .2s, box-shadow .2s, background .2s;
  }
  .btn svg { width: 18px; height: 18px; }
  .btn--primary {
    color: #fff;
    background: linear-gradient(135deg, var(--purple), var(--purple-2));
    box-shadow: 0 8px 28px rgba(139, 92, 246, .45);
  }
  .btn--primary:hover { transform: translateY(-2px); box-shadow: 0 12px 34px rgba(168, 85, 247, .6); }
  .btn--ghost { color: var(--text); border-color: rgba(192, 132, 252, .7); background: rgba(11, 7, 20, .25); }
  .btn--ghost:hover { background: rgba(139, 92, 246, .22); }
  .btn--disabled { opacity: .55; cursor: not-allowed; }
  .btn--disabled:hover { background: rgba(11, 7, 20, .25); }
  .hero__download { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .hero__coming-soon { margin: 0; font-size: 13px; color: var(--text-dim); letter-spacing: .04em; }
  .btn--sm { height: 40px; padding: 0 22px; font-size: 14px; }

  .menu-toggle {
    display: none; width: 44px; height: 44px; border-radius: 12px;
    background: var(--glass-fallback); border: 1px solid var(--glass-line);
    align-items: center; justify-content: center;
  }
  .menu-toggle svg { width: 22px; height: 22px; }

  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--bg-0);
  }
  .hero__bg {
    position: absolute; inset: 0; z-index: -3;
    background: url("/hero/hero_background.webp") center / cover no-repeat;
  }
  .hero__veil {
    position: absolute; inset: 0; z-index: -2;
    background:
      linear-gradient(90deg, rgba(11, 7, 20, .92) 0%, rgba(18, 10, 34, .80) 32%, rgba(18, 10, 34, .35) 62%, rgba(18, 10, 34, .15) 100%),
      linear-gradient(180deg, rgba(11, 7, 20, .70) 0%, rgba(11, 7, 20, 0) 22%, rgba(11, 7, 20, 0) 60%, rgba(18, 10, 34, .92) 100%),
      radial-gradient(60% 60% at 70% 45%, rgba(139, 92, 246, .28), transparent 70%);
  }

  .hero__inner {
    position: relative; z-index: 5;
    min-height: inherit;
    display: grid;
    grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
    padding: calc(var(--nav-h) + 4vh) clamp(20px, 4vw, 56px) 190px;
  }
  .hero__inner { pointer-events: none; }   /* 让下方群像区的箭头可点（inner 盒子铺满全宽且 z 高于 stage） */
  .hero__copy { pointer-events: auto; }
  .hero__copy { align-self: start; padding-top: clamp(8px, 4vh, 48px); max-width: 640px; }

  .wordmark {
    display: inline-flex; align-items: flex-start;
    margin: 0 0 8px;
    filter: drop-shadow(0 6px 24px rgba(139, 92, 246, .55));
  }
  .wordmark__logo {
    display: block;
    width: clamp(220px, 30vw, 400px);
    height: auto;
  }

  .hero__title {
    margin: 0;
    font-size: clamp(36px, 4.4vw, 68px);
    font-weight: 800; line-height: 1.08; letter-spacing: -0.02em;
    color: #fff;
  }
  .hero__title em {
    font-style: normal;
    background: linear-gradient(90deg, #E9D5FF, var(--purple-glow) 55%, var(--purple-2));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero__subtitle { margin: 18px 0 0; font-size: clamp(20px, 2.1vw, 30px); font-weight: 300; color: var(--text); }
  .hero__rule { width: 52px; height: 3px; border-radius: 3px; margin: 22px 0; background: var(--purple-glow); }
  .hero__desc { margin: 0 0 32px; font-size: clamp(15px, 1.25vw, 18px); color: var(--text); max-width: 30em; }
  .hero__desc span { display: block; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; }

  .stage { position: absolute; z-index: 3; top: var(--nav-h); bottom: 0; right: 0; width: 62%; pointer-events: none; overflow: hidden; }
  .stage::before {
    content: ""; position: absolute; left: 20%; right: 0; top: 10%; bottom: 0;
    background: radial-gradient(closest-side, rgba(168, 85, 247, .38), transparent 75%);
    filter: blur(20px);
  }
  .avatar {
    position: absolute; height: auto; width: auto; max-width: none; user-select: none; will-change: transform;
    transition:
      left .65s cubic-bezier(.22, .8, .2, 1),
      top .65s cubic-bezier(.22, .8, .2, 1),
      height .65s cubic-bezier(.22, .8, .2, 1),
      filter .65s ease,
      z-index .65s step-end;
  }

  /* 景深槽位：由 JS 按当前角色分配 data-slot（0 = 主角）。filter 列表保持一致才能平滑过渡。
     从左到右：slot3 远景 → slot2 左后景 → slot0 主角 → slot1 右近景；层级 z 随编号递增。 */
  .stage .avatar[data-slot="0"] {
    z-index: 4; left: 22%; top: 0%; height: 122%;
    filter: brightness(1) blur(0px) drop-shadow(0 0 28px rgba(192, 132, 252, .45)) drop-shadow(0 16px 36px rgba(0, 0, 0, .55));
  }
  .stage .avatar[data-slot="1"] {
    z-index: 3; left: 44%; top: 9%; height: 104%;
    filter: brightness(.9) blur(0px) drop-shadow(0 0 0 rgba(192, 132, 252, 0)) drop-shadow(0 10px 30px rgba(0, 0, 0, .5));
  }
  .stage .avatar[data-slot="2"] {
    z-index: 2; left: 8%; top: 15%; height: 100%;
    filter: brightness(.82) blur(.8px) drop-shadow(0 0 0 rgba(192, 132, 252, 0)) drop-shadow(0 10px 30px rgba(0, 0, 0, .5));
  }
  .stage .avatar[data-slot="3"] {
    z-index: 1; left: -6%; top: 4%; height: 108%;
    filter: brightness(.72) blur(1.4px) drop-shadow(0 0 0 rgba(192, 132, 252, 0)) drop-shadow(0 10px 30px rgba(0, 0, 0, .5));
  }

  .stage__arrow {
    position: absolute; z-index: 9; top: 52%;
    width: 48px; height: 48px; margin-top: -24px;
    display: grid; place-items: center;
    border-radius: 50%;
    color: #fff;
    background: var(--glass-fallback);
    border: 1px solid rgba(192, 132, 252, .5);
    box-shadow: 0 6px 22px rgba(11, 7, 20, .5), 0 0 16px rgba(139, 92, 246, .35);
    pointer-events: auto;
    transition: transform .2s, background .2s, box-shadow .2s;
  }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .stage__arrow, .bubble {
      background: rgba(255, 255, 255, .1);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
    }
  }
  .stage__arrow:hover { background: rgba(139, 92, 246, .55); box-shadow: 0 8px 26px rgba(139, 92, 246, .55); }
  .stage__arrow:active { transform: scale(.94); }
  .stage__arrow svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .stage__arrow--next { right: 3%; }

  .bubble {
    position: absolute; z-index: 9; left: 3%; top: 7%;
    width: max-content; max-width: min(260px, 46%);
    padding: 12px 16px 14px;
    border-radius: 18px 18px 4px 18px;
    color: var(--text);
    background: var(--glass-fallback);
    border: 1px solid rgba(192, 132, 252, .45);
    box-shadow: 0 10px 30px rgba(11, 7, 20, .5), 0 0 22px rgba(139, 92, 246, .3);
    pointer-events: none;
    transform-origin: 100% 100%;
  }
  .bubble::after {
    content: ""; position: absolute; right: 14px; bottom: -9px;
    width: 14px; height: 14px;
    background: inherit;
    border-left: 1px solid rgba(192, 132, 252, .45); border-bottom: 1px solid rgba(192, 132, 252, .45);
    transform: rotate(-45deg) skew(-8deg, -8deg);
    border-bottom-left-radius: 4px;
  }
  .bubble__name { display: block; margin-bottom: 2px; font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--purple-glow); }
  .bubble__text { margin: 0; font-size: 14px; line-height: 1.45; min-height: 2.9em; }
  .bubble__text::after {
    content: ""; display: inline-block; width: 2px; height: 1em; margin-left: 2px; vertical-align: -2px;
    background: var(--purple-glow); opacity: 0;
  }
  .bubble--typing .bubble__text::after { opacity: 1; animation: blink .8s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .bubble--pop { animation: pop .35s cubic-bezier(.2, 1.4, .4, 1); }
    @keyframes pop { from { opacity: 0; transform: scale(.85) translateY(6px); } to { opacity: 1; transform: none; } }
  }
  @media (prefers-reduced-motion: reduce) {
    .avatar { transition: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .avatar--deeyo { animation: float 7s ease-in-out infinite; }
    .avatar--yomiku { animation: float 6s ease-in-out -2s infinite; }
    .avatar--laysa { animation: float 8s ease-in-out -4s infinite; }
    .avatar--inp { animation: float 6.5s ease-in-out -1s infinite; }
    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  }

  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .menu-toggle, .nav--open {
      -webkit-backdrop-filter: blur(14px) saturate(1.2);
      backdrop-filter: blur(14px) saturate(1.2);
    }
