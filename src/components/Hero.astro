---
/**
 * 首页主视觉（一屏）。
 * 结构与视觉来自已验收的设计稿；文案全部取自 src/data/hero，不在此硬编码。
 * 图片为 public/hero 下的 webp（原 PNG 转码压缩后体积约为原来的 1/9）。
 */
import LocaleSwitcher from './LocaleSwitcher.astro';
import { FOOTER_NAV, PRIMARY_NAV } from '@/config/navigation';
import { getBrand } from '@/data/brand';
import { getHero } from '@/data/hero';
import { getHome } from '@/data/home';
import { t } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const hero = getHero(locale);
const brand = getBrand(locale);
const home = getHome(locale);
const currentPath = Astro.url.pathname;

/** 五张功能卡的图标（线性 SVG，自绘占位，待设计稿图标源文件替换） */
const icons: string[] = [
  '<svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.5a3.5 3.5 0 010 7M18 14.4c2.2.7 3.5 2.6 3.5 5.6"/></svg>',
  '<svg viewBox="0 0 24 24"><path d="M12 20.5s-8.5-5-8.5-11A4.8 4.8 0 0112 6.6 4.8 4.8 0 0120.5 9.5c0 6-8.5 11-8.5 11z"/></svg>',
  '<svg viewBox="0 0 24 24"><path d="M7 7h10a4.5 4.5 0 014.4 5.4l-.8 4A2.7 2.7 0 0116 17.6l-1.4-1.6H9.4L8 17.6a2.7 2.7 0 01-4.6-1.2l-.8-4A4.5 4.5 0 017 7z"/><path d="M8 10v3M6.5 11.5h3"/><circle cx="15.5" cy="10.5" r=".6"/><circle cx="17.5" cy="12.5" r=".6"/></svg>',
  '<svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="7" height="7" rx="1.8"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.8"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.8"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.8"/></svg>',
  '<svg viewBox="0 0 24 24"><path d="M12 2.8l8 4.4v9.6l-8 4.4-8-4.4V7.2z"/><path d="M4.3 7.4L12 12l7.7-4.6M12 12v9"/></svg>',
];
---

<header class="site-header">
  <a class="brand" href={localePath(locale, '/')} aria-label="INP home">
    <span class="brand__mark" aria-hidden="true">INP
      <svg viewBox="0 0 24 24"><path d="M12 1l3.1 7.4L23 9.2l-6 5.2 1.8 7.8L12 18l-6.8 4.2L7 14.4 1 9.2l7.9-.8z"/></svg>
    </span>
    <span class="brand__text">
      <span class="brand__name">{brand.name}</span>
      <span class="brand__tag">{brand.positioning}</span>
    </span>
  </a>

  <nav class="nav" id="site-nav" aria-label="Main">
    <ul class="nav__list">
      {PRIMARY_NAV.map((item) => {
        const href = localePath(locale, item.path);
        const isActive = currentPath === href || currentPath === href.replace(/\/$/, '');
        return (
          <li>
            <a href={href} aria-current={isActive ? 'page' : undefined} class="nav__link">
              {t(locale, item.labelKey)}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="header__actions">
    <div class="lang">
      <LocaleSwitcher {locale} path={currentPath} />
    </div>
    <a class="btn btn--primary btn--sm btn--header" href="#features">{t(locale, 'action.getStarted')}</a>
    <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</header>

<main id="top">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="hero__inner">
      <div class="hero__copy">
        <p class="wordmark" aria-hidden="true">{hero.wordmark}
          <svg viewBox="0 0 24 24"><path d="M12 1l3.1 7.4L23 9.2l-6 5.2 1.8 7.8L12 18l-6.8 4.2L7 14.4 1 9.2l7.9-.8z"/></svg>
        </p>
        <h1 class="hero__title" id="hero-title">{hero.titlePre} <em>{hero.titleEm}</em></h1>
        <p class="hero__subtitle">{hero.subtitle}</p>
        <div class="hero__rule" aria-hidden="true"></div>
        <p class="hero__desc">
          {hero.descLines.map((line) => <span>{line}</span>)}
        </p>
        <div class="hero__cta">
          {hero.ctas.map((cta, index) => (
            <a
              class:list={['btn', index === 0 ? 'btn--primary' : 'btn--ghost']}
              href={cta.path}
            >
              {index === 0 ? (
                <>{t(locale, cta.labelKey)}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </>
              ) : (
                <>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M10 8.5v7l5.5-3.5z" fill="currentColor"/></svg>
                  {t(locale, cta.labelKey)}
                </>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="stage" id="stage" role="group" aria-label="INP Avatars">
      <img class="avatar avatar--deeyo" src="/hero/avatar_01_deeyo.webp" width="787" height="1400" alt="Deeyo — silver-haired Avatar with a cyan halo" loading="eager" decoding="async">
      <img class="avatar avatar--yomiku" src="/hero/avatar_03_yomiku.webp" width="787" height="1400" alt="Yomiku — white-haired cat-ear Avatar in pink and white" loading="eager" decoding="async">
      <img class="avatar avatar--laysa" src="/hero/avatar_04_laysa.webp" width="787" height="1400" alt="Laysa — light-furred Avatar with pilot goggles" loading="eager" decoding="async">
      <img class="avatar avatar--inp" src="/hero/avatar_02_inp.webp" width="787" height="1400" alt="INP — purple-haired Avatar in street style" loading="eager" decoding="async">
    </div>

    <ul class="features" id="features" aria-label="Platform highlights">
      {hero.features.map((feature, index) => (
        <li class="feature">
          <span class="feature__icon" aria-hidden="true" set:html={icons[index] ?? ''} />
          <span>
            <span class="feature__name">{feature.name}</span>
            <span class="feature__desc">{feature.desc}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="story" id="story" aria-label="About INP">
    <div class="story__block">
      <h2>{home.introduction.heading}</h2>
      {home.introduction.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="story__block">
      <h2>{home.philosophy.heading}</h2>
      {home.philosophy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__line">{brand.footerBrandLine}</p>
      <p>{brand.positioning}</p>
      <p>{brand.slogan}</p>
    </div>

    <nav class="site-footer__navwrap" aria-label="Footer navigation">
      <ul class="site-footer__nav">
        {FOOTER_NAV.map((item) => {
          const href = localePath(locale, item.path);
          const isActive = currentPath === href || currentPath === href.replace(/\/$/, '');
          return (
            <li>
              <a href={href} aria-current={isActive ? 'page' : undefined}>
                {t(locale, item.labelKey)}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>

  <p class="site-footer__copy">{brand.copyright}</p>
</footer>

<script>
  const btn = document.getElementById('menu-toggle');
  const nav = document.getElementById('site-nav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('nav--open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) {
        nav.classList.remove('nav--open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

<style is:global>
  :root {
    --bg-0: #0B0714;
    --bg-1: #120A22;
    --purple: #8B5CF6;
    --purple-2: #A855F7;
    --purple-glow: #C084FC;
    --cyan: #22D3EE;
    --text: #E8E3F5;
    --text-dim: #A99FC4;
    --glass: rgba(255, 255, 255, 0.06);
    --glass-fallback: rgba(30, 18, 52, 0.88);
    --glass-line: rgba(255, 255, 255, 0.12);
    --radius: 16px;
    --nav-h: 68px;
    --font: "Inter", "PingFang SC", "微软雅黑", -apple-system, "Segoe UI", sans-serif;
  }

  html { background: var(--bg-0); scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg-0);
    color: var(--text);
    font-family: var(--font);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; cursor: pointer; }
  :focus-visible { outline: 2px solid var(--purple-glow); outline-offset: 3px; border-radius: 8px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>

<style>
  .site-header {
    position: absolute; top: 0; left: 0; right: 0; z-index: 20;
    height: var(--nav-h);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 clamp(20px, 4vw, 56px);
    background: linear-gradient(180deg, rgba(11, 7, 20, .75), rgba(11, 7, 20, 0));
  }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand__mark {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 4px 12px;
    border: 1.5px solid var(--purple-glow);
    border-radius: 10px;
    font-weight: 800; font-style: italic; font-size: 20px; letter-spacing: -0.02em;
    background: linear-gradient(135deg, rgba(139, 92, 246, .35), rgba(168, 85, 247, .15));
    box-shadow: 0 0 18px rgba(139, 92, 246, .45);
  }
  .brand__mark svg { width: 12px; height: 12px; fill: var(--purple-glow); }
  .brand__text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand__name { font-weight: 700; font-size: 16px; }
  .brand__tag { font-size: 12px; color: var(--text-dim); }

  .nav__list { display: flex; gap: clamp(20px, 3vw, 44px); list-style: none; margin: 0; padding: 0; }
  .nav__link { position: relative; padding: 8px 0; font-size: 15px; color: var(--text); opacity: .82; transition: opacity .2s; }
  .nav__link:hover { opacity: 1; }
  .nav__link[aria-current="page"] { opacity: 1; font-weight: 600; }
  .nav__link[aria-current="page"]::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
    background: var(--purple-glow); border-radius: 2px;
  }

  .header__actions { display: flex; align-items: center; gap: 18px; }
  .lang { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 48px; padding: 0 28px;
    border-radius: 999px; border: 1px solid transparent;
    font-size: 16px; font-weight: 600; white-space: nowrap;
    transition: transform .2s, box-shadow .2s, background .2s;
  }
  .btn svg { width: 18px; height: 18px; }
  .btn--primary {
    color: #fff;
    background: linear-gradient(135deg, var(--purple), var(--purple-2));
    box-shadow: 0 8px 28px rgba(139, 92, 246, .45);
  }
  .btn--primary:hover { transform: translateY(-2px); box-shadow: 0 12px 34px rgba(168, 85, 247, .6); }
  .btn--ghost { color: var(--text); border-color: rgba(192, 132, 252, .7); background: rgba(11, 7, 20, .25); }
  .btn--ghost:hover { background: rgba(139, 92, 246, .22); }
  .btn--sm { height: 40px; padding: 0 22px; font-size: 14px; }

  .menu-toggle {
    display: none; width: 44px; height: 44px; border-radius: 12px;
    background: var(--glass-fallback); border: 1px solid var(--glass-line);
    align-items: center; justify-content: center;
  }
  .menu-toggle svg { width: 22px; height: 22px; }

  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--bg-0);
  }
  .hero__bg {
    position: absolute; inset: 0; z-index: -3;
    background: url("/hero/hero_background.webp") center / cover no-repeat;
  }
  .hero__veil {
    position: absolute; inset: 0; z-index: -2;
    background:
      linear-gradient(90deg, rgba(11, 7, 20, .92) 0%, rgba(18, 10, 34, .80) 32%, rgba(18, 10, 34, .35) 62%, rgba(18, 10, 34, .15) 100%),
      linear-gradient(180deg, rgba(11, 7, 20, .70) 0%, rgba(11, 7, 20, 0) 22%, rgba(11, 7, 20, 0) 60%, rgba(18, 10, 34, .92) 100%),
      radial-gradient(60% 60% at 70% 45%, rgba(139, 92, 246, .28), transparent 70%);
  }

  .hero__inner {
    position: relative; z-index: 5;
    min-height: inherit;
    display: grid;
    grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
    padding: calc(var(--nav-h) + 4vh) clamp(20px, 4vw, 56px) 190px;
  }
  .hero__copy { align-self: start; padding-top: clamp(8px, 4vh, 48px); max-width: 640px; }

  .wordmark {
    display: inline-flex; align-items: flex-start; gap: 6px;
    margin: 0 0 8px;
    font-size: clamp(64px, 9vw, 128px);
    font-weight: 800; font-style: italic; line-height: .95; letter-spacing: -0.04em;
    background: linear-gradient(120deg, #fff 10%, var(--purple-glow) 90%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 6px 24px rgba(139, 92, 246, .55));
  }
  .wordmark svg { width: .26em; height: .26em; fill: var(--purple-2); margin-top: .1em; -webkit-text-fill-color: initial; }

  .hero__title {
    margin: 0;
    font-size: clamp(36px, 4.4vw, 68px);
    font-weight: 800; line-height: 1.08; letter-spacing: -0.02em;
    color: #fff;
  }
  .hero__title em {
    font-style: normal;
    background: linear-gradient(90deg, #E9D5FF, var(--purple-glow) 55%, var(--purple-2));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero__subtitle { margin: 18px 0 0; font-size: clamp(20px, 2.1vw, 30px); font-weight: 300; color: var(--text); }
  .hero__rule { width: 52px; height: 3px; border-radius: 3px; margin: 22px 0; background: var(--purple-glow); }
  .hero__desc { margin: 0 0 32px; font-size: clamp(15px, 1.25vw, 18px); color: var(--text); max-width: 30em; }
  .hero__desc span { display: block; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; }

  .stage { position: absolute; z-index: 3; top: var(--nav-h); bottom: 0; right: 0; width: 62%; pointer-events: none; overflow: hidden; }
  .stage::before {
    content: ""; position: absolute; left: 20%; right: 0; top: 10%; bottom: 0;
    background: radial-gradient(closest-side, rgba(168, 85, 247, .38), transparent 75%);
    filter: blur(20px);
  }
  .avatar { position: absolute; height: auto; max-width: none; user-select: none; will-change: transform; }

  .avatar--deeyo {
    z-index: 1; left: 0%; top: 3%; height: 108%;
    filter: brightness(.72) saturate(.95) blur(1.4px) drop-shadow(0 10px 30px rgba(0, 0, 0, .5));
  }
  .avatar--yomiku {
    z-index: 2; left: 41%; top: 8%; height: 104%;
    filter: brightness(.82) blur(.8px) drop-shadow(0 10px 30px rgba(0, 0, 0, .5));
  }
  .avatar--laysa {
    z-index: 3; right: -3%; top: 17%; height: 100%;
    filter: brightness(.9) drop-shadow(0 10px 30px rgba(0, 0, 0, .5));
  }
  .avatar--inp {
    z-index: 4; left: 17%; top: 0%; height: 122%;
    filter: drop-shadow(0 0 28px rgba(192, 132, 252, .45)) drop-shadow(0 16px 36px rgba(0, 0, 0, .55));
  }

  @media (prefers-reduced-motion: no-preference) {
    .avatar--deeyo { animation: float 7s ease-in-out infinite; }
    .avatar--yomiku { animation: float 6s ease-in-out -2s infinite; }
    .avatar--laysa { animation: float 8s ease-in-out -4s infinite; }
    .avatar--inp { animation: float 6.5s ease-in-out -1s infinite; }
    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  }

  .features {
    position: absolute; z-index: 10; left: clamp(20px, 4vw, 56px); right: clamp(20px, 4vw, 56px); bottom: 28px;
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px;
    list-style: none; margin: 0; padding: 0;
  }
  .feature {
    display: flex; align-items: center; gap: 14px;
    padding: 16px 18px;
    border-radius: var(--radius);
    background: rgba(18, 10, 34, 0.55);
    border: 1px solid var(--glass-line);
  }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .feature, .menu-toggle, .nav--open {
      -webkit-backdrop-filter: blur(14px) saturate(1.2);
      backdrop-filter: blur(14px) saturate(1.2);
    }
  }
  .feature__icon {
    flex: none; width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center;
    background: rgba(139, 92, 246, .28); border: 1px solid rgba(192, 132, 252, .35);
    color: var(--purple-glow);
  }
  .feature__icon svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .feature__name { display: block; font-size: 17px; font-weight: 700; color: #fff; }
  .feature__desc { display: block; font-size: 13px; color: var(--text-dim); }

  @media (max-width: 1280px) {
    .feature { padding: 14px; gap: 10px; }
    .feature__icon { width: 40px; height: 40px; }
    .feature__icon svg { width: 22px; height: 22px; }
    .feature__name { font-size: 15px; }
    .feature__desc { font-size: 12px; }
  }

  @media (max-width: 1023.98px) {
    .menu-toggle { display: inline-flex; }
    .brand__tag { display: none; }
    .btn--header { display: none; }
    .nav { position: absolute; top: calc(var(--nav-h) - 6px); left: 16px; right: 16px; display: none; }
    .nav--open {
      display: block; padding: 10px 20px; border-radius: var(--radius);
      background: var(--glass-fallback); border: 1px solid var(--glass-line);
    }
    .nav__list { flex-direction: column; gap: 0; }
    .nav__link { display: block; padding: 14px 0; border-bottom: 1px solid var(--glass-line); }
    .nav__list li:last-child .nav__link { border-bottom: 0; }
    .nav__link[aria-current="page"]::after { display: none; }

    .hero { min-height: auto; }
    .hero__veil {
      background:
        linear-gradient(180deg, rgba(11, 7, 20, .88) 0%, rgba(18, 10, 34, .72) 45%, rgba(18, 10, 34, .95) 100%),
        radial-gradient(70% 40% at 60% 55%, rgba(139, 92, 246, .3), transparent 70%);
    }
    .hero__inner {
      display: flex; flex-direction: column;
      padding: calc(var(--nav-h) + 20px) 20px 0;
      min-height: 0;
    }
    .hero__copy { max-width: none; padding-top: 0; }
    .wordmark { font-size: clamp(56px, 18vw, 96px); }
    .hero__title { font-size: clamp(32px, 9vw, 52px); }
    .hero__cta .btn { flex: 1 1 160px; }

    .stage { position: relative; top: auto; right: auto; bottom: auto; width: 100%; height: clamp(380px, 92vw, 640px); margin-top: 12px; z-index: 3; }
    .stage::before { left: 0; top: 0; }
    .avatar--deeyo { left: -4%; top: 6%; height: 112%; }
    .avatar--yomiku { left: 46%; top: 10%; height: 100%; }
    .avatar--laysa { right: -8%; top: 24%; height: 92%; }
    .avatar--inp { left: 22%; top: 0; height: 120%; }

    .features {
      position: relative; z-index: 10; left: auto; right: auto; bottom: auto;
      margin: -20px 20px 0; padding-bottom: 28px;
      grid-template-columns: repeat(2, 1fr); gap: 12px;
    }
    .features .feature:last-child { grid-column: 1 / -1; }
    .hero { padding-bottom: 8px; }
  }

  @media (max-width: 420px) {
    .feature { flex-direction: column; align-items: flex-start; }
  }

  .site-footer {
    border-top: 1px solid var(--glass-line);
    background: var(--bg-0);
    padding: 26px clamp(20px, 4vw, 56px) 0;
  }
  .site-footer__inner {
    display: flex; flex-wrap: wrap; gap: 20px 48px;
    justify-content: space-between; align-items: flex-start;
  }
  .site-footer__brand { display: flex; flex-direction: column; gap: 3px; font-size: 13px; color: var(--text-dim); }
  .site-footer__brand p { margin: 0; }
  .site-footer__line { color: var(--text); font-weight: 600; }
  .site-footer__nav { display: flex; flex-wrap: wrap; gap: 6px 20px; list-style: none; margin: 0; padding: 0; font-size: 13px; }
  .site-footer__nav a { color: var(--text-dim); transition: color .2s; }
  .site-footer__nav a:hover { color: var(--text); }
  .site-footer__copy {
    margin: 18px 0 0;
    padding: 14px 0 22px;
    border-top: 1px solid var(--glass-line);
